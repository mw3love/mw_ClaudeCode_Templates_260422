#!/bin/bash
# pre-push hook: README에 변경 이력 자동 추가

while read local_ref local_sha remote_ref remote_sha; do
    # 삭제 push 스킵
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

    # 변경 이력 커밋이면 스킵 (무한루프 방지)
    LAST_MSG=$(git log -1 --pretty=%s "$local_sha")
    if [[ "$LAST_MSG" == "docs: 변경 이력"* ]]; then
        exit 0
    fi

    export DATE=$(date +"%Y-%m-%d")
    export PC=$(hostname)

    # 푸쉬되는 커밋 중 첫 번째 메시지 (변경 이력 커밋 제외)
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        export COMMIT_MSG=$(git log --pretty="%s" -1 "$local_sha")
    else
        export COMMIT_MSG=$(git log --pretty="%s" "${remote_sha}..${local_sha}" \
            | grep -v "^docs: 변경 이력" | head -1)
    fi

    # README 변경 이력 테이블에 새 행 삽입
    python - <<'PYEOF'
import re, os
date = os.environ['DATE']
pc   = os.environ['PC']
msg  = os.environ['COMMIT_MSG'].replace('|', '/')

with open('README.md', encoding='utf-8') as f:
    content = f.read()

new_row = f'| {date} | {pc} | {msg} |'
content = re.sub(
    r'(\| 날짜 \| PC \| 커밋 메시지 \|\n\|[-| ]+\|)',
    r'\1\n' + new_row,
    content
)

with open('README.md', 'w', encoding='utf-8') as f:
    f.write(content)
PYEOF

    git add README.md
    git commit -m "docs: 변경 이력 업데이트 ($PC)"
done

exit 0
